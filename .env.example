# Copy to .env. Never committed.

# --- Database ---------------------------------------------------------------
# On the server, compose assembles DATABASE_URL from this. Do not set
# DATABASE_URL there yourself.
#   openssl rand -hex 24
DB_PASSWORD=

# Local development only, where there is no compose interpolation. On the
# server compose's environment: block overrides this, and .dockerignore keeps
# .env out of the image entirely.
DATABASE_URL=postgresql://steward:CHANGEME@localhost:5434/steward

# --- First user -------------------------------------------------------------
# Read once by prisma/seed.ts, then dead. The seeded password is temporary:
# the app forces a change on first sign-in.
SEED_EMAIL=
SEED_PASSWORD=
SEED_DISPLAY_NAME=Vincent

# --- Cookies ----------------------------------------------------------------
# "true" while Steward is reached over plain HTTP on the LAN. Remove it once
# every route in is HTTPS.
ALLOW_HTTP=true

# --- Unraid -----------------------------------------------------------------
# The icon shown in Unraid's Docker tab. Unraid keys it to the container name
# and fetches this URL, so it must be reachable when Steward itself is not.
STEWARD_ICON_URL=https://raw.githubusercontent.com/Pallarran/Steward/main/public/steward-icon.png

# --- Uptime Kuma ------------------------------------------------------------
# Read through /metrics, which needs an API key: Uptime Kuma -> profile menu
# -> Settings -> API Keys -> Add API Key. Sent as HTTP Basic with an empty
# username.
KUMA_BASE_URL=http://<whitetower-lan-ip>:1001
KUMA_KEY=

# --- Todoist ----------------------------------------------------------------
# Personal API token: Todoist -> Settings -> Integrations -> Developer.
# Sent as `Authorization: Bearer`. Read and write: ticking closes the task.
TODOIST_TOKEN=

# --- Sources (added as their build steps arrive) ----------------------------
