# Copy to .env. Never committed.

# --- Database ---------------------------------------------------------------
# On the server, compose assembles DATABASE_URL from this. Do not set
# DATABASE_URL there yourself.
#   openssl rand -hex 24
DB_PASSWORD=

# Local development only, where there is no compose interpolation. On the
# server compose's environment: block overrides this, and .dockerignore keeps
# .env out of the image entirely.
DATABASE_URL=postgresql://steward:CHANGEME@localhost:5434/steward

# --- First user -------------------------------------------------------------
# Read once by prisma/seed.ts, then dead. The seeded password is temporary:
# the app forces a change on first sign-in.
SEED_EMAIL=
SEED_PASSWORD=
SEED_DISPLAY_NAME=Vincent

# --- Cookies ----------------------------------------------------------------
# "true" while Steward is reached over plain HTTP on the LAN. Remove it once
# every route in is HTTPS.
ALLOW_HTTP=true

# --- Unraid -----------------------------------------------------------------
# The icon shown in Unraid's Docker tab. Unraid keys it to the container name
# and fetches this URL, so it must be reachable when Steward itself is not.
STEWARD_ICON_URL=https://raw.githubusercontent.com/Pallarran/Steward/main/public/steward-icon.png

# --- Unraid -----------------------------------------------------------------
# The WhiteTower card on /systems: array usage, disk temperatures, read/write
# errors, and whatever parity is doing.
#
# Where the read-only bind mount lands inside the container — see
# docker-compose.yml. Steward runs on the Unraid box, so it reads the same
# .ini files the webGUI does. No plugin, no API key, no Unraid Connect.
#
# Leave it unset anywhere that is not the server: the card then says it is not
# connected, which is true, rather than showing an empty array as a healthy one.
UNRAID_STATE_DIR=/host/emhttp

# --- Uptime Kuma ------------------------------------------------------------
# Read through /metrics, which needs an API key: Uptime Kuma -> profile menu
# -> Settings -> API Keys -> Add API Key. Sent as HTTP Basic with an empty
# username.
KUMA_BASE_URL=http://<whitetower-lan-ip>:1001
KUMA_KEY=

# --- Todoist ----------------------------------------------------------------
# Personal API token: Todoist -> Settings -> Integrations -> Developer.
# Sent as `Authorization: Bearer`. Read and write: ticking closes the task.
TODOIST_TOKEN=

# --- Home Assistant ---------------------------------------------------------
# Long-lived access token: HA -> your name in the sidebar -> Security ->
# Long-lived access tokens -> Create token.
#
# Use an IP, never a `.local` mDNS name. Those resolve on a desktop and not
# inside a container, and Home Assistant is not necessarily on the same host as
# Steward.
HA_BASE_URL=http://<home-assistant-ip>:8123
HA_TOKEN=

# --- Horizon ----------------------------------------------------------------
# The finance panel reads GET /api/summary — aggregate figures only, no
# holdings and no transactions.
#
# The key is shared: generate it once with `openssl rand -hex 32`, put it in
# Horizon's own .env as STEWARD_API_KEY, and the same value here. With it unset
# on either side, the panel says it is not connected and Horizon serves nothing.
HORIZON_BASE_URL=http://<whitetower-lan-ip>:3001
HORIZON_API_KEY=

# --- Paperless-ngx ----------------------------------------------------------
# The document search on /documents. Optional: with either unset, that section
# says it is not connected and the rest of the page works normally.
#
# Token: Paperless -> your profile (top right) -> API Auth Token. Sent as
# `Authorization: Token`, not Bearer.
#
# Steward never copies the archive. It asks Paperless when you ask it, so
# Paperless stays the document store — PRD §5.
PAPERLESS_BASE_URL=http://<whitetower-lan-ip>:8000
PAPERLESS_TOKEN=
