# Copy to .env. Never committed.

# --- Database ---------------------------------------------------------------
# On the server, compose assembles DATABASE_URL from this. Do not set
# DATABASE_URL there yourself.
#   openssl rand -base64 24
DB_PASSWORD=

# Local development only, where there is no compose interpolation.
DATABASE_URL=postgresql://steward:CHANGEME@localhost:5434/steward

# --- First user -------------------------------------------------------------
# Read once by prisma/seed.ts, then dead. The seeded password is temporary:
# the app forces a change on first sign-in.
SEED_EMAIL=
SEED_PASSWORD=
SEED_DISPLAY_NAME=Vincent

# --- Cookies ----------------------------------------------------------------
# "true" while Steward is reached over plain HTTP on the LAN. Remove it once
# every route in is HTTPS.
ALLOW_HTTP=true

# --- Unraid -----------------------------------------------------------------
# The icon shown in Unraid's Docker tab. Steward serves it itself, so no
# public repo is needed. Use WhiteTower's LAN address.
STEWARD_ICON_URL=http://192.168.1.200:3002/steward-icon.png

# --- Sources (added as their build steps arrive) ----------------------------
# HA_BASE_URL=
# HA_TOKEN=
# KUMA_BASE_URL=
# KUMA_KEY=
# HORIZON_BASE_URL=
