// docs/ARCHITECTURE.md is the spec for everything below.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// One human. Steward has a login because it is reachable from outside the
// house over Tailscale — PRD §4, "Remote access". No roles, no household,
// no locale: Horizon's User stripped to what a single user actually needs.
model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String // argon2id. NEVER plaintext.
  displayName        String
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())

  sessions Session[]
}

// Opaque random token matched on lookup, so there is nothing to sign and no
// session secret to keep. See docs/ARCHITECTURE.md, "Secrets and network".
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  // No @@index([token]): @unique already creates one, and declaring both
  // costs a second index write on every session insert and delete.
  @@index([userId])
}

// Key/value for theme and anything else per-user.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ============================================================================
// THE QUEUE
// ============================================================================

/// The seven adapters, plus `capture`. Quick capture is not an adapter — it is
/// local, and it writes straight to Steward's own inbox — but an Item still
/// needs to say where it came from.
enum SourceKey {
  ha
  rss
  kuma
  todoist
  unraid
  /// The machine, as distinct from `unraid`, which is its array. /proc for what
  /// the OS is doing, the BMC over Redfish for what the hardware is doing.
  server
  horizon
  vault
  gmail
  capture
  /// Steward's own list, not a collected source. The relationship nudge needs a
  /// provenance like everything else in the queue.
  people
  /// Also Steward's own: the couple planner's open-slot nudge.
  family
  /// And again: the renewal notice. PRD §3.3 keeps subscriptions in while
  /// putting every other document-derived deadline out.
  subscriptions
}

/// Drives the coloured chip on a queue row.
enum ItemCategory {
  systems
  school
  couple
  news
  gaming
  subscriptions
  inbox
  /// One-on-one time with a daughter. Purple, like school and couple —
  /// docs/DESIGN.md gives that accent to family.
  family
  /// Keeping in touch with anyone else. Rose, which docs/DESIGN.md gives to
  /// people — before this existed the nudge wore the slate Inbox chip.
  people
  /// An unread email. Deliberately not `inbox`: that one means Todoist's Inbox,
  /// something Vincent chose to write down and has not triaged. A mail is
  /// somebody else's demand, arriving unasked.
  mail
}

/// `dismissed` is only ever set on items where "gone" is true and final. A
/// still-due task is ticked, never dismissed: hiding it would create a private
/// notion of "cleared" that Todoist does not share, and the two then drift.
enum ItemStatus {
  new
  seen
  dismissed
}

/// One row per thing that arrived. The queue is one prioritized list, no tiers.
model Item {
  id String @id @default(cuid())

  source     SourceKey
  /// Stable per source: RSS uses the entry guid or URL, HA the entity id plus
  /// the relevant timestamp, Uptime Kuma the monitor id plus incident start.
  externalId String

  category ItemCategory
  title    String
  subtitle String?
  url      String?

  /// Extra for the detail dialog, and **only** what the dialog needs and cannot
  /// get by joining. Most sources need none of this: a subscription row finds
  /// its `Subscription` by id, a monitor row finds its `Monitor` by name. This
  /// is for the ones with nothing to join to — today just Gmail's sender
  /// address, since Steward stores no mail anywhere else.
  ///
  /// A Json column with no stated purpose becomes a junk drawer. The rule is in
  /// docs/ARCHITECTURE.md: if it can be joined, join it.
  detail Json?

  /// Sort key for the single list, **ascending**: 0 sits at the top. Position
  /// carries the priority, so nothing renders this number.
  priority Int @default(0)

  occurredAt DateTime
  /// News gets about 48h. Most things get none.
  expiresAt  DateTime?

  status      ItemStatus @default(new)
  dismissedAt DateTime?

  createdAt DateTime @default(now())

  activities Activity[]

  /// The dedupe rule. Every adapter must produce a stable external id.
  @@unique([source, externalId])
  /// The queue's own read: live items, in order.
  @@index([status, priority])
  /// Expiry sweep.
  @@index([expiresAt])
}

// ============================================================================
// COLLECTOR HEALTH
// ============================================================================

/// One row per adapter, and what the staleness rule reads.
///
/// A collector that has not succeeded within three times its interval turns
/// its panel amber and names how long it has been stale. This table is not
/// logging: it is the data that drives that.
model SourceStatus {
  source          SourceKey @id
  intervalSeconds Int

  /// Drives the "as of" stamp on every panel.
  lastSuccessAt DateTime?
  lastErrorAt   DateTime?
  /// Shown to Vincent when the panel goes amber, so it names the collector
  /// rather than blaming the service.
  lastError     String?

  /// Drives exponential backoff. Reset to 0 by any success.
  consecutiveFailures Int @default(0)

  updatedAt DateTime @updatedAt
}

/// Uptime Kuma's monitor states, as of the last successful poll.
///
/// This is what the gate card reads. It is not in the original data-model
/// sketch: the sketch assumed monitor state would arrive as queue items, but
/// the gate is a panel showing *current* state, and an Item is a record of
/// something that *arrived*. Conflating them would have meant either a queue
/// full of fifteen rows or a gate that could not say what is up right now.
/// Small current-state facts an adapter reads but that do not belong in `Item`.
///
/// State rather than arrivals: an unavailable-entity count, the pending-update
/// split, a portfolio summary. None is a thing that arrived and needs clearing,
/// and each is one row that would otherwise be a model of its own.
///
/// These lived as JSON in `Setting` until a second source started writing them,
/// which `docs/ARCHITECTURE.md` named as the moment to promote them. `source`
/// and `at` are why the table earns its place: a fact can now say who wrote it
/// and when, so a panel can date itself by the fact rather than by its
/// collector's last run — which matters when the two differ, as they do for
/// prices fetched on weekdays and read on a Sunday.
/// A recurring charge — PRD component 7, and the one deadline §3.3 keeps.
///
/// Steward owns this: the PRD lists it as a data-entry debt, "one sitting",
/// which really means a page to fill in as he goes.
model Subscription {
  id String @id @default(cuid())

  name        String
  /// Integer cents, the way Horizon does money. A float here would round
  /// wrong on the monthly-equivalent total, which is the whole point of it.
  amountCents Int
  currency    String @default("CAD")

  cadence SubscriptionCadence @default(monthly)

  /// **A** known renewal date, not necessarily the next one.
  ///
  /// The next renewal is derived by rolling this forward until it is no longer
  /// past — never stored. Nothing has to run to keep it right, it cannot drift,
  /// and it is correct again the moment Steward comes back from a month off.
  renewsOn DateTime @db.Date

  /// "Visa ·1234". Which card it hits, because that is what you need to know
  /// when you are cancelling it.
  card      String?
  cancelUrl String?
  notes     String?

  /// Kept rather than deleted when it is cancelled, so the record survives.
  active Boolean @default(true)

  /// Days of warning before the renewal. Null is never — his threshold, not
  /// the system's. Ten by default, matching the Home artboard's row.
  noticeDays Int? @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

/// One line of the household cheat-sheet — PRD component 7.
///
/// Paint colours, filter sizes, model numbers, the guest wifi. The things you
/// look up twice a year and can never find.
model CheatSheetEntry {
  id String @id @default(cuid())

  /// Free text — "House", "Car", "Network". Groups the list.
  area  String
  label String
  value String

  /// Masks the value behind a reveal. **Not encryption**: the value is
  /// plaintext in Postgres and in the nightly dump on the array. It keeps the
  /// guest wifi off the screen when someone is looking over your shoulder, and
  /// it is not a password manager.
  secret Boolean @default(false)

  notes    String?
  position Int     @default(0)

  createdAt DateTime @default(now())

  @@index([position])
}

/// One month of the alternating couple plan — PRD component 5.
///
/// Steward owns this rather than reading `Couple-Activity-Planner.md`, at
/// Vincent's decision on 2026-08-31: Cowork stays where he explores ideas and
/// works out a plan, and Steward holds what is parked and what is booked, so
/// there is always a view and a nudge. The vault therefore stays unmounted, and
/// the regulatory question about `Work-HQ` never arises.
model CoupleSlot {
  id String @id @default(cuid())

  /// `YYYY-MM`. A string because it is a calendar month, not an instant, and
  /// sorts correctly as text.
  month String @unique
  /// Whose turn it is: true for Vincent, false for his spouse. He takes even
  /// months and she odd ones, but it is stored rather than derived because
  /// they swap and give each other slack.
  ///
  /// A boolean rather than a name, changed 2026-08-31. The names are data now —
  /// his from `User.displayName`, hers from the `spouse` person — and a stored
  /// name would go stale the moment either was edited.
  mine Boolean

  title  String?
  detail String?
  status SlotStatus @default(open)

  /// The real date once there is one — often not in its own month, since a show
  /// that lands nearby counts through the flexibility rule.
  eventDate DateTime?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// One of the girls, and the one-on-one time with her — PRD component 5.
///
/// Deliberately simpler than the couple planner: there is no alternating
/// cadence to honour, only the question the mockup asks — is something planned,
/// and if not, what is in her bank.

/// The idea bank. Shared model, scoped by whose bank it is.
model Idea {
  id    String  @id @default(cuid())
  text  String
  notes String?

  /// Null is the couple's shared bank; set is that person's own.
  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: Cascade)

  /// Set when it becomes a plan, so the bank shows what is still available
  /// without losing the record of what was used.
  usedAt DateTime?

  createdAt DateTime @default(now())

  @@index([usedAt])
  @@index([personId])
}

/// Someone worth keeping in touch with — PRD component 8.
///
/// Steward owns this list. There is no source to collect it from: the PRD is
/// blunt that "no software fills these", and the answer is that Vincent fills
/// it here, the way he fills in feeds and launcher tiles.
///
/// **Deliberately outside the XP economy**, and it must stay outside when the
/// game layer arrives. PRD §6: measurement alone made an activity feel like
/// work and cut voluntary continuation from 48.5% to 27.3%. Vincent decided to
/// keep last-contact visible anyway, on the grounds that the evidence is
/// adjacent rather than about this case — recorded as his call, and §2 lists
/// watching whether it changes how the calls feel.
model Person {
  id String @id @default(cuid())

  name String

  /// **Behaviour, not a label.** `spouse` drives the alternating month planner,
  /// `child` a current plan and her own bank, `contact` the last-contact list.
  /// Merged 2026-08-31 at Vincent's suggestion — a daughter and a friend were
  /// two tables only because they were written a day apart.
  kind PersonKind @default(contact)
  /// Free text grouping for `contact` people — "Family", "Friends",
  /// "Neighbours". The label half of his tag, kept separate from the behaviour
  /// half so a new grouping costs nothing.
  circle String?

  /// Free text: "Mother", "Friend since school".
  relation String?
  /// The loose intention, in his words — "call every few weeks".
  intention String?

  /// The ceiling, in days, before a nudge. Null means no nudge ever: some
  /// people are worth keeping in view without a clock on them.
  cadenceDays Int?

  /// The last time you actually saw or spoke to them. For a child this is set
  /// by marking an outing done.
  lastContactAt DateTime?
  /// What `lastContactAt` was before the last tap, so a mis-tap is undoable.
  /// Without it, one wrong press silently destroys the real date.
  previousContactAt DateTime?

  /// The next thing planned together. **Available to anyone** — "lunch with Dad
  /// on Sunday" is the same idea as an afternoon with a daughter — the
  /// children's section simply leads with it.
  planTitle String?
  planDate  DateTime?

  position  Int      @default(0)
  createdAt DateTime @default(now())

  ideas Idea[]

  @@index([kind])
  @@index([position])
}

model SystemFact {
  key    String    @id
  value  Json
  source SourceKey
  /// When the fact was true at the source, which is not always when it was written.
  at     DateTime

  updatedAt DateTime @updatedAt

  @@index([source])
}

model Monitor {
  id String @id @default(cuid())

  /// From the `monitor_name` label. Uptime Kuma's /metrics exposes no monitor
  /// id, so the name is the only stable handle there is — renaming a monitor
  /// in Kuma therefore reads as a new monitor here.
  name String @unique
  url  String?
  type String?

  status MonitorStatus

  /// Milliseconds, from the `monitor_response_time` series, as of the last
  /// poll. Nullable because a monitor type that reports none, or a Kuma that
  /// stops publishing the series, must leave the tile blank rather than show a
  /// zero — the same rule the rest of the app follows about numbers Steward
  /// does not have. This is what the service tile's caption says, because the
  /// uptime duration the mockup drew is not something /metrics can supply.
  responseMs Int?

  /// When `status` last changed. This is what "down for 41 minutes" counts
  /// from, and it is inferred from transitions because /metrics reports only
  /// the current state.
  changedAt DateTime
  /// Last successful poll that mentioned this monitor. A monitor deleted in
  /// Kuma simply stops being seen, and the gate stops counting it.
  seenAt    DateTime

  updatedAt DateTime @updatedAt

  @@index([status])
}

/// Uptime Kuma's numeric status: 0 down, 1 up, 2 pending, 3 maintenance.
enum MonitorStatus {
  down
  up
  pending
  maintenance
}

/// Home Assistant calendar events, as of the last successful poll.
///
/// A live list, like Monitor and Task. Events are current state — they move,
/// get cancelled, and recur — not records of something that arrived.
///
/// `calendar.home` and `calendar.inbox` are deliberately never fetched: they
/// are the Home Assistant Todoist integration mirroring the same tasks the
/// Today card already gets from Todoist directly. Checked, not assumed —
/// all 28 of calendar.home's events matched a Todoist task by exact title.
model CalendarEvent {
  id String @id @default(cuid())

  /// `<calendarId>:<uid>:<startDate>`. Home Assistant gives every event a
  /// stable `uid`, and the start date separates one instance of a recurring
  /// event from the next.
  externalId String @unique

  calendarId  String
  summary     String
  description String?
  location    String?

  /// `YYYY-MM-DD` of the start, always set. Kept as text for the same reason
  /// Task.dueDate is: an all-day event is a claim about a calendar day.
  startDate String
  /// Set only for timed events.
  startAt   DateTime?
  endAt     DateTime?
  allDay    Boolean

  /// Set when the event belongs to someone else and is shown marked as theirs.
  sharedWith String?

  seenAt DateTime

  updatedAt DateTime @updatedAt

  @@index([startDate])
  @@index([calendarId])
}

/// Todoist tasks that are due or overdue, as of the last successful poll.
///
/// A live list, not queue items — the same distinction as Monitor. A task is
/// current state that changes under you (two thirds of Vincent's dated tasks
/// recur), while an Item records something that arrived once. Tasks get ticked,
/// never dismissed.
///
/// Only due-or-overdue tasks are stored. Of 188 active tasks that is about 17,
/// and the rest are none of Steward's business.
model Task {
  id String @id @default(cuid())

  /// Todoist's own task id. Stable, unlike Uptime Kuma's monitors.
  externalId String @unique

  content     String
  description String?
  url         String?

  projectId   String?
  projectName String?
  /// Todoist's scale, where 4 is the highest. Stored but not used to filter:
  /// a third of Vincent's tasks sit at 4, so it does not discriminate.
  priority    Int     @default(1)
  labels      String[]

  /// The raw `YYYY-MM-DD` Todoist gave, kept as text on purpose. A date-only
  /// due date is a statement about a calendar day, and turning it into an
  /// instant invents a timezone the source never specified.
  dueDate String
  /// Set only when Todoist actually carried a time.
  dueAt   DateTime?

  isRecurring Boolean @default(false)

  /// Last successful poll that returned this task. Anything older has been
  /// completed, rescheduled or deleted in Todoist, and is pruned.
  seenAt DateTime

  updatedAt DateTime @updatedAt

  @@index([dueDate])
}

// ============================================================================
// NEWS
// ============================================================================

/// How a feed's URL was arrived at. Stored because it decides how a new one is
/// discovered from whatever Vincent pastes, and it is worth being able to say
/// "this is a YouTube channel" on the settings page.
/// What kind of attention someone gets. Behaviour, not a label — the free-text
/// `circle` on `Person` is what groups the contacts.
enum PersonKind {
  spouse
  child
  contact
}

enum SubscriptionCadence {
  weekly
  monthly
  quarterly
  yearly
}

/// Where a couple slot has got to. `open` is the one that earns a nudge.
enum SlotStatus {
  open
  planning
  booked
  done
}

enum FeedKind {
  site
  youtube
  steam
}

/// A bucket news is grouped into, and the unit the morning ranking works over.
///
/// Topics exist so one noisy subject cannot drown the rest: the ranker promotes
/// the best few *per topic*, not the best few overall.
model Topic {
  id   String @id @default(cuid())
  name String @unique
  /// Manual ordering on the News page and in settings.
  position Int @default(0)

  createdAt DateTime @default(now())

  feeds    Feed[]
  articles Article[]
}

/// One RSS or Atom feed.
///
/// The URL is the resolved feed, never the page Vincent pasted: a site's
/// homepage, a YouTube channel and a Steam store link all get turned into a
/// real feed URL and then fetched once to prove it parses, before the row is
/// written. A feed that does not work is never saved.
model Feed {
  id String @id @default(cuid())

  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  /// The resolved feed URL. Unique so the same source cannot be added twice.
  url   String   @unique
  /// What Vincent actually pasted, kept so the settings page can show it.
  input String
  title String
  kind  FeedKind

  /// Muted rather than deleted: a feed that turns out noisy can be silenced
  /// for a week without losing the URL.
  enabled Boolean @default(true)

  /// Rule 2 applies per feed. A feed that has 404'd for a month must say so on
  /// the settings page rather than quietly making its topic look thin.
  lastFetchedAt DateTime?
  lastSuccessAt DateTime?
  lastError     String?
  /// Conditional requests: unlike Uptime Kuma's metrics, a feed's body really
  /// does stay identical between polls, so these save the transfer.
  etag          String?
  lastModified  String?

  articleCount Int @default(0)

  createdAt DateTime @default(now())

  articles Article[]

  @@index([topicId])
  @@index([enabled])
}

/// The staging pool: everything collected, whether or not it was ever promoted.
///
/// `docs/ARCHITECTURE.md` originally had the unpromoted ones discarded unseen.
/// They are kept now because the News page is where Vincent reads — an article
/// the ranker passed over is still worth being able to find. They expire on a
/// retention window rather than living forever.
model Article {
  id String @id @default(cuid())

  feedId  String
  feed    Feed   @relation(fields: [feedId], references: [id], onDelete: Cascade)
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  /// The entry's guid, or its URL when it has none.
  externalId String
  title      String
  url        String
  summary    String?
  author     String?

  publishedAt DateTime

  /// Set when the morning ranking promoted it into the queue.
  promotedAt DateTime?
  /// Rule 3: a read article is gone.
  readAt     DateTime?

  createdAt DateTime @default(now())

  @@unique([feedId, externalId])
  @@index([topicId, publishedAt])
  @@index([readAt])
}

// ============================================================================
// THE GAME LAYER
// ============================================================================

enum ActivityKind {
  cleared
  ticked
  filed
}

/// One row per thing Vincent did.
///
/// Level and "remaining this week" are both derived from this table.
/// **Nothing stores a score.**
model Activity {
  id     String       @id @default(cuid())
  kind   ActivityKind
  points Int

  /// Kept when the item goes: the points were earned either way.
  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  /// "Remaining this week" reads a date range.
  @@index([createdAt])
  @@index([itemId])
}
