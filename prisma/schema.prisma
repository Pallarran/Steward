// docs/ARCHITECTURE.md is the spec for everything below.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// One human. Steward has a login because it is reachable from outside the
// house over Tailscale — PRD §4, "Remote access". No roles, no household,
// no locale: Horizon's User stripped to what a single user actually needs.
model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String // argon2id. NEVER plaintext.
  displayName        String
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())

  sessions Session[]
}

// Opaque random token matched on lookup, so there is nothing to sign and no
// session secret to keep. See docs/ARCHITECTURE.md, "Secrets and network".
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  // No @@index([token]): @unique already creates one, and declaring both
  // costs a second index write on every session insert and delete.
  @@index([userId])
}

// Key/value for theme and anything else per-user.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ============================================================================
// THE QUEUE
// ============================================================================

/// The seven adapters, plus `capture`. Quick capture is not an adapter — it is
/// local, and it writes straight to Steward's own inbox — but an Item still
/// needs to say where it came from.
enum SourceKey {
  ha
  rss
  kuma
  todoist
  unraid
  horizon
  vault
  gmail
  capture
}

/// Drives the coloured chip on a queue row.
enum ItemCategory {
  systems
  school
  couple
  news
  gaming
  subscriptions
  inbox
}

/// `dismissed` is only ever set on items where "gone" is true and final. A
/// still-due task is ticked, never dismissed: hiding it would create a private
/// notion of "cleared" that Todoist does not share, and the two then drift.
enum ItemStatus {
  new
  seen
  dismissed
}

/// One row per thing that arrived. The queue is one prioritized list, no tiers.
model Item {
  id String @id @default(cuid())

  source     SourceKey
  /// Stable per source: RSS uses the entry guid or URL, HA the entity id plus
  /// the relevant timestamp, Uptime Kuma the monitor id plus incident start.
  externalId String

  category ItemCategory
  title    String
  subtitle String?
  url      String?

  /// Sort key for the single list, **ascending**: 0 sits at the top. Position
  /// carries the priority, so nothing renders this number.
  priority Int @default(0)

  occurredAt DateTime
  /// News gets about 48h. Most things get none.
  expiresAt  DateTime?

  status      ItemStatus @default(new)
  dismissedAt DateTime?

  createdAt DateTime @default(now())

  activities Activity[]

  /// The dedupe rule. Every adapter must produce a stable external id.
  @@unique([source, externalId])
  /// The queue's own read: live items, in order.
  @@index([status, priority])
  /// Expiry sweep.
  @@index([expiresAt])
}

// ============================================================================
// COLLECTOR HEALTH
// ============================================================================

/// One row per adapter, and what the staleness rule reads.
///
/// A collector that has not succeeded within three times its interval turns
/// its panel amber and names how long it has been stale. This table is not
/// logging: it is the data that drives that.
model SourceStatus {
  source          SourceKey @id
  intervalSeconds Int

  /// Drives the "as of" stamp on every panel.
  lastSuccessAt DateTime?
  lastErrorAt   DateTime?
  /// Shown to Vincent when the panel goes amber, so it names the collector
  /// rather than blaming the service.
  lastError     String?

  /// Drives exponential backoff. Reset to 0 by any success.
  consecutiveFailures Int @default(0)

  updatedAt DateTime @updatedAt
}

/// Uptime Kuma's monitor states, as of the last successful poll.
///
/// This is what the gate card reads. It is not in the original data-model
/// sketch: the sketch assumed monitor state would arrive as queue items, but
/// the gate is a panel showing *current* state, and an Item is a record of
/// something that *arrived*. Conflating them would have meant either a queue
/// full of fifteen rows or a gate that could not say what is up right now.
model Monitor {
  id String @id @default(cuid())

  /// From the `monitor_name` label. Uptime Kuma's /metrics exposes no monitor
  /// id, so the name is the only stable handle there is — renaming a monitor
  /// in Kuma therefore reads as a new monitor here.
  name String @unique
  url  String?
  type String?

  status MonitorStatus

  /// When `status` last changed. This is what "down for 41 minutes" counts
  /// from, and it is inferred from transitions because /metrics reports only
  /// the current state.
  changedAt DateTime
  /// Last successful poll that mentioned this monitor. A monitor deleted in
  /// Kuma simply stops being seen, and the gate stops counting it.
  seenAt    DateTime

  updatedAt DateTime @updatedAt

  @@index([status])
}

/// Uptime Kuma's numeric status: 0 down, 1 up, 2 pending, 3 maintenance.
enum MonitorStatus {
  down
  up
  pending
  maintenance
}

/// Home Assistant calendar events, as of the last successful poll.
///
/// A live list, like Monitor and Task. Events are current state — they move,
/// get cancelled, and recur — not records of something that arrived.
///
/// `calendar.home` and `calendar.inbox` are deliberately never fetched: they
/// are the Home Assistant Todoist integration mirroring the same tasks the
/// Today card already gets from Todoist directly. Checked, not assumed —
/// all 28 of calendar.home's events matched a Todoist task by exact title.
model CalendarEvent {
  id String @id @default(cuid())

  /// `<calendarId>:<uid>:<startDate>`. Home Assistant gives every event a
  /// stable `uid`, and the start date separates one instance of a recurring
  /// event from the next.
  externalId String @unique

  calendarId  String
  summary     String
  description String?
  location    String?

  /// `YYYY-MM-DD` of the start, always set. Kept as text for the same reason
  /// Task.dueDate is: an all-day event is a claim about a calendar day.
  startDate String
  /// Set only for timed events.
  startAt   DateTime?
  endAt     DateTime?
  allDay    Boolean

  /// Set when the event belongs to someone else and is shown marked as theirs.
  sharedWith String?

  seenAt DateTime

  updatedAt DateTime @updatedAt

  @@index([startDate])
  @@index([calendarId])
}

/// Todoist tasks that are due or overdue, as of the last successful poll.
///
/// A live list, not queue items — the same distinction as Monitor. A task is
/// current state that changes under you (two thirds of Vincent's dated tasks
/// recur), while an Item records something that arrived once. Tasks get ticked,
/// never dismissed.
///
/// Only due-or-overdue tasks are stored. Of 188 active tasks that is about 17,
/// and the rest are none of Steward's business.
model Task {
  id String @id @default(cuid())

  /// Todoist's own task id. Stable, unlike Uptime Kuma's monitors.
  externalId String @unique

  content     String
  description String?
  url         String?

  projectId   String?
  projectName String?
  /// Todoist's scale, where 4 is the highest. Stored but not used to filter:
  /// a third of Vincent's tasks sit at 4, so it does not discriminate.
  priority    Int     @default(1)
  labels      String[]

  /// The raw `YYYY-MM-DD` Todoist gave, kept as text on purpose. A date-only
  /// due date is a statement about a calendar day, and turning it into an
  /// instant invents a timezone the source never specified.
  dueDate String
  /// Set only when Todoist actually carried a time.
  dueAt   DateTime?

  isRecurring Boolean @default(false)

  /// Last successful poll that returned this task. Anything older has been
  /// completed, rescheduled or deleted in Todoist, and is pruned.
  seenAt DateTime

  updatedAt DateTime @updatedAt

  @@index([dueDate])
}

// ============================================================================
// THE GAME LAYER
// ============================================================================

enum ActivityKind {
  cleared
  ticked
  filed
}

/// One row per thing Vincent did.
///
/// Level and "remaining this week" are both derived from this table.
/// **Nothing stores a score.**
model Activity {
  id     String       @id @default(cuid())
  kind   ActivityKind
  points Int

  /// Kept when the item goes: the points were earned either way.
  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  /// "Remaining this week" reads a date range.
  @@index([createdAt])
  @@index([itemId])
}
